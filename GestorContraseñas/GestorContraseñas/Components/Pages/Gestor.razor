@page "/gestor"
@rendermode InteractiveServer
@using GestorContraseñas.Components.Models
@using GestorContraseñas.Components.Services
@inject IPasswordService PasswordService

<PageTitle>Gestor de Contraseñas</PageTitle>

<div class="container mt-4">
    <h2><i class="bi bi-shield-lock"></i> Ejercicio 23: Gestor de Contraseñas</h2>
    <hr />

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    @(esEdicion ? "Editar Credencial" : "Nueva Credencial")
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Servicio</label>
                        <input @bind="modelo.Servicio" class="form-control" placeholder="Ej: GitHub, Azure..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Usuario</label>
                        <input @bind="modelo.Usuario" class="form-control" />
                    </div>

                    <div class="card bg-light p-3 mb-3 border-0">
                        <h6 class="text-muted"><i class="bi bi-gear"></i> Generador Seguro</h6>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" @bind="configLongitud" class="form-control form-control-sm" min="8" max="32" />
                            </div>
                            <div class="col-6 d-flex align-items-center">
                                <div class="form-check">
                                    <input type="checkbox" @bind="configSimbolos" class="form-check-input" id="checkSim" />
                                    <label class="form-check-label small" for="checkSim">Símbolos</label>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-outline-primary btn-sm mt-2 w-100" @onclick="GenerarNueva">
                            Generar Password
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Contraseña</label>
                        <div class="input-group">
                            <input type="@(verPassword ? "text" : "password")" 
                                   value="@modelo.Password" 
                                   @oninput="OnPasswordInput"
                                   class="form-control" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => verPassword = !verPassword">
                                <i class="bi @(verPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                        <div class="progress mt-2" style="height: 8px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                 style="width: @(GetProgresoFortaleza())%; background-color: @modelo.ColorFortaleza"></div>
                        </div>
                        <small class="text-muted">Análisis: <strong>@modelo.Fortaleza</strong></small>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn @(esEdicion ? "btn-warning" : "btn-success") w-100" @onclick="ProcesarFormulario">
                            <i class="bi bi-check-circle"></i> @(esEdicion ? "Actualizar" : "Guardar")
                        </button>
                        @if (esEdicion)
                        {
                            <button class="btn btn-secondary" @onclick="CancelarEdicion">Cancelar</button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger mt-3 py-2 small">@mensajeError</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="input-group mb-4 shadow-sm" style="border-radius: 10px; overflow: hidden;">
                <span class="input-group-text bg-white border-end-0 text-primary">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" @bind="terminoBusqueda" @bind:event="oninput" @onkeyup="Filtrar" 
                       class="form-control border-start-0 ps-0" 
                       placeholder="Filtrar por nombre de servicio..." />
            </div>

            <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">Servicio</th>
                                <th class="py-3 text-uppercase small fw-bold text-muted">Usuario</th>
                                <th class="py-3 text-uppercase small fw-bold text-muted">Seguridad</th>
                                <th class="py-3 text-center text-uppercase small fw-bold text-muted">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!credencialesFiltradas.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        No hay credenciales registradas
                                    </td>
                                </tr>
                            }
                            @foreach (var cred in credencialesFiltradas)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3 text-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="bi bi-globe"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@cred.Servicio</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary">@cred.Usuario</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle me-2" style="width: 10px; height: 10px; background-color: @cred.ColorFortaleza;"></div>
                                            <span class="badge rounded-pill text-dark" style="background-color: @(cred.ColorFortaleza + "40"); border: 1px solid @cred.ColorFortaleza;">
                                                @cred.Fortaleza
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button class="btn btn-primary d-flex align-items-center justify-content-center shadow-sm" 
                                                    style="width: 45px; height: 45px; border-radius: 10px;"
                                                    title="Editar Credencial" 
                                                    @onclick="() => PrepararEdicion(cred)">
                                                <i class="bi bi-pencil-fill fs-5"></i>
                                            </button>

                                            <button class="btn btn-danger d-flex align-items-center justify-content-center shadow-sm" 
                                                    style="width: 45px; height: 45px; border-radius: 10px;"
                                                    title="Eliminar Permanente" 
                                                    @onclick="() => Eliminar(cred.Id)">
                                                <i class="bi bi-trash3-fill fs-5"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="mt-3 px-2 d-flex justify-content-between align-items-center text-muted small">
                <span>Total: <strong>@credencialesFiltradas.Count</strong> registros</span>
                <span><i class="bi bi-info-circle me-1"></i> Haz clic en editar para ver/cambiar contraseña</span>
            </div>
        </div>
    </div>
</div>

@code {
    private Credencial modelo = new();
    private List<Credencial> credencialesFiltradas = new();
    private int configLongitud = 12;
    private bool configSimbolos = true;
    private bool verPassword = false;
    private bool esEdicion = false;
    private string terminoBusqueda = "";
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        await ActualizarLista();
    }

    private void OnPasswordInput(ChangeEventArgs e)
    {
        modelo.Password = e.Value?.ToString() ?? "";
        modelo.Fortaleza = PasswordService.EvaluarFortaleza(modelo.Password);
    }

    private void GenerarNueva()
    {
        modelo.Password = PasswordService.GenerarPassword(configLongitud, configSimbolos);
        modelo.Fortaleza = PasswordService.EvaluarFortaleza(modelo.Password);
    }

    private async Task ProcesarFormulario()
    {
        if (string.IsNullOrWhiteSpace(modelo.Servicio) || string.IsNullOrWhiteSpace(modelo.Password))
        {
            mensajeError = "Completa los campos obligatorios.";
            return;
        }

        if (esEdicion)
        {
            await PasswordService.ModificarPassword(modelo.Id, modelo.Password);
        }
        else
        {
            if (await PasswordService.VerificarPasswordsRepetidos(modelo.Password))
            {
                mensajeError = "Esta contraseña ya existe en otro registro.";
                return;
            }
            await PasswordService.AgregarCredencial(modelo);
        }

        await CancelarEdicion();
        await ActualizarLista();
    }

    private void PrepararEdicion(Credencial seleccionada)
    {
        // Clonamos para no editar directamente en la lista antes de guardar
        modelo = new Credencial 
        { 
            Id = seleccionada.Id, 
            Servicio = seleccionada.Servicio, 
            Usuario = seleccionada.Usuario, 
            Password = seleccionada.Password,
            Fortaleza = seleccionada.Fortaleza
        };
        esEdicion = true;
        mensajeError = "";
    }

    private async Task CancelarEdicion()
    {
        modelo = new();
        esEdicion = false;
        mensajeError = "";
        verPassword = false;
        await Task.CompletedTask;
    }

    private async Task Filtrar()
    {
        if (string.IsNullOrWhiteSpace(terminoBusqueda))
        {
            await ActualizarLista();
        }
        else
        {
            var res = await PasswordService.BuscarPorServicio(terminoBusqueda);
            credencialesFiltradas = res != null ? new List<Credencial> { res } : new();
        }
    }

    private async Task ActualizarLista() => credencialesFiltradas = await PasswordService.ObtenerTodas();

    private async Task Eliminar(Guid id)
    {
        await PasswordService.EliminarCredencial(id);
        await ActualizarLista();
    }

    private int GetProgresoFortaleza() => modelo.Fortaleza switch
    {
        NivelFortaleza.MuyFuerte => 100,
        NivelFortaleza.Fuerte => 75,
        NivelFortaleza.Media => 50,
        NivelFortaleza.Debil => 25,
        _ => 10
    };
}